{
  "name": "words",
  "version": "1.5.0",
  "license": "MIT",
  "engines": {
    "node": ">= 14.20.0",
    "npm": ">= 8.0.0"
  },
  "author": "Mateusz Psuja",
  "scripts": {
    "precommit": "npm run lint",
    "prepush": "ng test --watch=false",
    "init": "./copyEnvFiles.sh",
    "ng": "ng",
    "start": "ng serve",
    "start:production": "ng serve --configuration production",
    "build:production": "ng build --configuration production",
    "build:staging": "ng build --configuration staging",
    "build:workspace": "ng build --configuration workspace",
    "build:dev": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "npm run lint:scss && npm run lint:ts && npm run lint:html",
    "lint:ts": "tslint \"src/**/*.ts\"",
    "lint:scss": "sass-lint src/",
    "lint:html": "htmllint -- 'src/**/*.html'"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/platform-server": "^15.2.10",
    "@angular/router": "^15.2.10",
    "@ngrx/effects": "^15.0.0",
    "@ngrx/router-store": "^15.0.0",
    "@ngrx/store": "^15.0.0",
    "@ngrx/store-devtools": "^15.0.0",
    "bootstrap": "^4.0.0",
    "core-js": "^3.19.1",
    "ngrx-store-localstorage": "^15.0.0",
    "ngx-bootstrap": "^10.3.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.4.0",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^15.2.10",
    "@angular/language-service": "^15.2.10",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^16.18.0",
    "htmllint": "^0.6.0",
    "htmllint-cli": "0.0.6",
    "husky": "^8.0.0",
    "jasmine-core": "~4.5.0",
    "jasmine-marbles": "^0.9.2",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-cli": "^2.0.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "sass-lint": "^1.12.1",
    "ts-node": "^10.9.1",
    "tslint": "~6.1.0",
    "typescript": "4.8.4"
  }
}
